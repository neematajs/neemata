{
  "name": "@nmtjs/neem",
  "version": "0.19.0-alpha.5",
  "description": "Neem application host built on Effect: builds, development reloads, and supervised worker lifecycles.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/neematajs/neemata",
    "directory": "packages/neem"
  },
  "scripts": {
    "build": "tsrs -b tsconfig.build.json",
    "clean-build": "rm -rf ./dist",
    "check:type": "tsrs -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts",
    "test:stress": "pnpm run build && vitest run --config vitest.stress.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "bin": {
    "neem": "./bin/neem.js"
  },
  "exports": {
    ".": {
      "types": "./src/public/index.ts",
      "import": "./dist/public/index.js",
      "module-sync": "./dist/public/index.js"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "import": "./dist/cli.js",
      "module-sync": "./dist/cli.js"
    },
    "./host": {
      "types": "./src/host.ts",
      "import": "./dist/host.js",
      "module-sync": "./dist/host.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/public/index.d.ts",
        "import": "./dist/public/index.js",
        "module-sync": "./dist/public/index.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "import": "./dist/cli.js",
        "module-sync": "./dist/cli.js"
      },
      "./host": {
        "types": "./dist/host.d.ts",
        "import": "./dist/host.js",
        "module-sync": "./dist/host.js"
      }
    }
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "@nmtjs/common": "workspace:*",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "oxc-resolver": "^11.21.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "pino-std-serializers": "^7.0.0",
    "rolldown": "catalog:",
    "effect": "^4.0.6",
    "@effect/platform-node": "^4.0.6"
  },
  "peerDependencies": {
    "@nmtjs/proxy": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@nmtjs/metrics": "workspace:*",
    "@nmtjs/proxy": "1.0.0-beta.10",
    "@types/node": "^24.13.2"
  },
  "files": [
    "bin",
    "dist",
    "lib",
    "LICENSE.md",
    "README.md"
  ]
}
