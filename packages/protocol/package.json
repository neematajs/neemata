{
  "name": "@nmtjs/protocol",
  "description": "Binary protocol implementation for Neemata clients and servers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/common/index.ts",
      "import": "./dist/common/index.js",
      "module-sync": "./dist/common/index.js"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./dist/server/index.js",
      "module-sync": "./dist/server/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./dist/client/index.js",
      "module-sync": "./dist/client/index.js"
    },
    "./json/client": {
      "types": "./src/json/client.ts",
      "import": "./dist/json/client.js",
      "module-sync": "./dist/json/client.js"
    },
    "./json/server": {
      "types": "./src/json/server.ts",
      "import": "./dist/json/server.js",
      "module-sync": "./dist/json/server.js"
    },
    "./msgpack": {
      "types": "./src/msgpack/common.ts",
      "import": "./dist/msgpack/common.js",
      "module-sync": "./dist/msgpack/common.js"
    },
    "./msgpack/client": {
      "types": "./src/msgpack/client.ts",
      "import": "./dist/msgpack/client.js",
      "module-sync": "./dist/msgpack/client.js"
    },
    "./msgpack/server": {
      "types": "./src/msgpack/server.ts",
      "import": "./dist/msgpack/server.js",
      "module-sync": "./dist/msgpack/server.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/common/index.d.ts",
        "import": "./dist/common/index.js",
        "module-sync": "./dist/common/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js",
        "module-sync": "./dist/server/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "module-sync": "./dist/client/index.js"
      },
      "./json/client": {
        "types": "./dist/json/client.d.ts",
        "import": "./dist/json/client.js",
        "module-sync": "./dist/json/client.js"
      },
      "./json/server": {
        "types": "./dist/json/server.d.ts",
        "import": "./dist/json/server.js",
        "module-sync": "./dist/json/server.js"
      },
      "./msgpack": {
        "types": "./dist/msgpack/common.d.ts",
        "import": "./dist/msgpack/common.js",
        "module-sync": "./dist/msgpack/common.js"
      },
      "./msgpack/client": {
        "types": "./dist/msgpack/client.d.ts",
        "import": "./dist/msgpack/client.js",
        "module-sync": "./dist/msgpack/client.js"
      },
      "./msgpack/server": {
        "types": "./dist/msgpack/server.d.ts",
        "import": "./dist/msgpack/server.js",
        "module-sync": "./dist/msgpack/server.js"
      }
    }
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@nmtjs/common": "workspace:*"
  },
  "devDependencies": {
    "@nmtjs/client": "workspace:*",
    "@nmtjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@nmtjs/common": "workspace:*"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "README.md"
  ]
}
