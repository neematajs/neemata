{
  "name": "@nmtjs/ws-transport",
  "description": "Neemata WebSocket handler for shared server transports.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "crossws": "0.4.6"
  },
  "devDependencies": {
    "@nmtjs/application": "workspace:*",
    "@nmtjs/client": "workspace:*",
    "@nmtjs/common": "workspace:*",
    "@nmtjs/contract": "workspace:*",
    "@nmtjs/gateway": "workspace:*",
    "@nmtjs/http-transport": "workspace:*",
    "@nmtjs/json-format": "workspace:*",
    "@nmtjs/protocol": "workspace:*",
    "@nmtjs/server-host": "workspace:*",
    "@nmtjs/type": "workspace:*",
    "@nmtjs/ws-client": "workspace:*"
  },
  "peerDependencies": {
    "@nmtjs/application": "workspace:*",
    "@nmtjs/common": "workspace:*",
    "@nmtjs/core": "workspace:*",
    "@nmtjs/gateway": "workspace:*",
    "@nmtjs/protocol": "workspace:*",
    "@nmtjs/server-host": "workspace:*",
    "@types/node": "^24.13.2"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.0",
    "deno": ">=2.3.0"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "README.md"
  ]
}
