{
  "name": "@nmtjs/nuxt",
  "description": "Neem runtime preset for hosting Nuxt apps.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean-build": "rm -rf ./dist",
    "check:type": "tsc -p tsconfig.json --noEmit",
    "playground:dev": "cd playground && neem dev",
    "playground:build": "cd playground && neem build",
    "playground:start": "cd playground && neem start",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    },
    "./neem/worker": {
      "types": "./src/neem/worker.ts",
      "import": "./dist/neem/worker.js",
      "module-sync": "./dist/neem/worker.js"
    },
    "./neem/planner": {
      "types": "./src/neem/planner.ts",
      "import": "./dist/neem/planner.js",
      "module-sync": "./dist/neem/planner.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js"
      },
      "./neem/worker": {
        "types": "./dist/neem/worker.d.ts",
        "import": "./dist/neem/worker.js",
        "module-sync": "./dist/neem/worker.js"
      },
      "./neem/planner": {
        "types": "./dist/neem/planner.d.ts",
        "import": "./dist/neem/planner.js",
        "module-sync": "./dist/neem/planner.js"
      }
    }
  },
  "dependencies": {
    "@nmtjs/neem": "workspace:*"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "nuxt": "^4.5.1",
    "rolldown": "^1.1.2"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "README.md"
  ]
}
