{
  "name": "@nmtjs/pubsub",
  "version": "0.18.0-alpha.4",
  "description": "Typed ephemeral publish/subscribe channels for Effect, with Redis and Valkey brokers.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/neematajs/neemata",
    "directory": "packages/pubsub"
  },
  "scripts": {
    "clean-build": "rm -rf ./dist",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts tests/integration"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js",
      "module-sync": "./dist/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js",
        "module-sync": "./dist/*.js"
      }
    }
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0",
    "effect": "^4.0.0",
    "ioredis": "^5.11.1",
    "iovalkey": "^0.3.3"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "ioredis": "^5.10.1",
    "iovalkey": "^0.3.3"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "iovalkey": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "README.md"
  ]
}
