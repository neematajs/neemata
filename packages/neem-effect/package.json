{
  "name": "@nmtjs/neem-effect",
  "version": "0.18.0-alpha.4",
  "description": "Neem host built on Effect: the same builds, CLI and runtime contract, supervised by Effect scopes and fibers.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/neematajs/neemata",
    "directory": "packages/neem-effect"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean-build": "rm -rf ./dist",
    "check:type": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "pnpm --filter @nmtjs/neem run build && pnpm run build && vitest run --config vitest.e2e.config.ts",
    "test:stress": "pnpm --filter @nmtjs/neem run build && pnpm run build && vitest run --config vitest.stress.config.ts"
  },
  "bin": {
    "neem-effect": "./bin/neem-effect.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "import": "./dist/cli.js",
      "module-sync": "./dist/cli.js"
    },
    "./host": {
      "types": "./src/host.ts",
      "import": "./dist/host.js",
      "module-sync": "./dist/host.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "import": "./dist/cli.js",
        "module-sync": "./dist/cli.js"
      },
      "./host": {
        "types": "./dist/host.d.ts",
        "import": "./dist/host.js",
        "module-sync": "./dist/host.js"
      }
    }
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0",
    "@nmtjs/neem": "workspace:*",
    "effect": "^4.0.0",
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "@nmtjs/proxy": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@nmtjs/proxy": "1.0.0-beta.10",
    "@types/node": "^24.13.2"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE.md",
    "README.md"
  ]
}
