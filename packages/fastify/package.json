{
  "name": "@nmtjs/fastify",
  "description": "Neem runtime helpers for hosting Fastify applications.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean-build": "rm -rf ./dist",
    "test": "vitest run --config vitest.config.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@nmtjs/common": "workspace:*",
    "@nmtjs/core": "workspace:*",
    "@nmtjs/neem": "workspace:*"
  },
  "peerDependencies": {
    "fastify": ">=5.0.0"
  },
  "devDependencies": {
    "@fastify/websocket": "^11.3.0",
    "@nmtjs/proxy": "1.0.0-beta.7",
    "@types/ws": "^8.18.1",
    "fastify": "^5.12.1"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
