{
  "name": "@nmtjs/workflows",
  "version": "0.19.0-alpha.5",
  "description": "Durable, Effect-native workflows for Neemata: tasks, workflow graphs, workers and PostgreSQL, Redis or in-memory stores.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/neematajs/neemata",
    "directory": "packages/workflows"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    },
    "./postgres": {
      "types": "./src/postgres/index.ts",
      "import": "./dist/postgres/index.js",
      "module-sync": "./dist/postgres/index.js"
    },
    "./postgres/pg": {
      "types": "./src/postgres/pg.ts",
      "import": "./dist/postgres/pg.js",
      "module-sync": "./dist/postgres/pg.js"
    },
    "./postgres/pglite": {
      "types": "./src/postgres/pglite.ts",
      "import": "./dist/postgres/pglite.js",
      "module-sync": "./dist/postgres/pglite.js"
    },
    "./postgres/drizzle": {
      "types": "./src/postgres/drizzle.ts",
      "import": "./dist/postgres/drizzle.js",
      "module-sync": "./dist/postgres/drizzle.js"
    },
    "./redis": {
      "types": "./src/redis/index.ts",
      "import": "./dist/redis/index.js",
      "module-sync": "./dist/redis/index.js"
    },
    "./neem": {
      "types": "./src/neem/index.ts",
      "import": "./dist/neem/index.js",
      "module-sync": "./dist/neem/index.js"
    },
    "./neem/worker": {
      "types": "./src/neem/worker.ts",
      "import": "./dist/neem/worker.js",
      "module-sync": "./dist/neem/worker.js"
    },
    "./inspector": {
      "types": "./src/inspector.ts",
      "import": "./dist/inspector.js",
      "module-sync": "./dist/inspector.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js"
      },
      "./postgres": {
        "types": "./dist/postgres/index.d.ts",
        "import": "./dist/postgres/index.js",
        "module-sync": "./dist/postgres/index.js"
      },
      "./postgres/pg": {
        "types": "./dist/postgres/pg.d.ts",
        "import": "./dist/postgres/pg.js",
        "module-sync": "./dist/postgres/pg.js"
      },
      "./postgres/pglite": {
        "types": "./dist/postgres/pglite.d.ts",
        "import": "./dist/postgres/pglite.js",
        "module-sync": "./dist/postgres/pglite.js"
      },
      "./postgres/drizzle": {
        "types": "./dist/postgres/drizzle.d.ts",
        "import": "./dist/postgres/drizzle.js",
        "module-sync": "./dist/postgres/drizzle.js"
      },
      "./redis": {
        "types": "./dist/redis/index.d.ts",
        "import": "./dist/redis/index.js",
        "module-sync": "./dist/redis/index.js"
      },
      "./neem": {
        "types": "./dist/neem/index.d.ts",
        "import": "./dist/neem/index.js",
        "module-sync": "./dist/neem/index.js"
      },
      "./neem/worker": {
        "types": "./dist/neem/worker.d.ts",
        "import": "./dist/neem/worker.js",
        "module-sync": "./dist/neem/worker.js"
      },
      "./inspector": {
        "types": "./dist/inspector.d.ts",
        "import": "./dist/inspector.js",
        "module-sync": "./dist/inspector.js"
      }
    }
  },
  "scripts": {
    "clean-build": "rm -rf ./dist",
    "test:integration": "vitest run --config vitest.config.ts tests/integration"
  },
  "dependencies": {
    "@nmtjs/common": "workspace:*",
    "@nmtjs/neem": "workspace:*",
    "cron-parser": "^5.6.1"
  },
  "peerDependencies": {
    "@effect/sql-pg": "^4.0.6",
    "@effect/sql-pglite": "^4.0.6",
    "@nmtjs/effect": "workspace:*",
    "drizzle-orm": ">=1.0.0-rc.4 <2.0.0",
    "effect": "^4.0.6"
  },
  "peerDependenciesMeta": {
    "@effect/sql-pg": {
      "optional": true
    },
    "@effect/sql-pglite": {
      "optional": true
    },
    "@nmtjs/effect": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "README.md"
  ],
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/sql-pg": "4.0.6",
    "@effect/sql-pglite": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@nmtjs/effect": "workspace:*",
    "@nmtjs/proxy": "1.0.0-beta.10",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.6",
    "redis": "6.2.1"
  }
}
