{
  "name": "@nmtjs/metrics",
  "version": "0.18.0-alpha.3",
  "description": "Neem metrics helpers and Prometheus-compatible observer.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/neematajs/neemata",
    "directory": "packages/metrics"
  },
  "scripts": {
    "clean-build": "rm -rf ./dist",
    "test": "vitest run --config vitest.config.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    },
    "./neem": {
      "types": "./src/neem/index.ts",
      "import": "./dist/neem/index.js",
      "module-sync": "./dist/neem/index.js"
    },
    "./neem/plugin": {
      "types": "./src/neem/plugin.ts",
      "import": "./dist/neem/plugin.js",
      "module-sync": "./dist/neem/plugin.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js"
      },
      "./neem": {
        "types": "./dist/neem/index.d.ts",
        "import": "./dist/neem/index.js",
        "module-sync": "./dist/neem/index.js"
      },
      "./neem/plugin": {
        "types": "./dist/neem/plugin.d.ts",
        "import": "./dist/neem/plugin.js",
        "module-sync": "./dist/neem/plugin.js"
      }
    }
  },
  "dependencies": {
    "@nmtjs/common": "workspace:*",
    "@nmtjs/neem": "workspace:*",
    "@nmtjs/prom-client": "workspace:^",
    "pino": "^10.3.1"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "README.md"
  ]
}
