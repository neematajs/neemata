{
  "name": "@nmtjs/transports",
  "description": "First-party transports, server hosts, and protocol handlers for Neemata.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module-sync": "./dist/index.js"
    },
    "./host/bun": {
      "types": "./src/host/bun.ts",
      "import": "./dist/host/bun.js",
      "module-sync": "./dist/host/bun.js"
    },
    "./host/deno": {
      "types": "./src/host/deno.ts",
      "import": "./dist/host/deno.js",
      "module-sync": "./dist/host/deno.js"
    },
    "./host/node": {
      "types": "./src/host/node.ts",
      "import": "./dist/host/node.js",
      "module-sync": "./dist/host/node.js"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "import": "./dist/http/index.js",
      "module-sync": "./dist/http/index.js"
    },
    "./ws": {
      "types": "./src/ws/index.ts",
      "import": "./dist/ws/index.js",
      "module-sync": "./dist/ws/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "module-sync": "./dist/index.js"
      },
      "./host/bun": {
        "types": "./dist/host/bun.d.ts",
        "import": "./dist/host/bun.js",
        "module-sync": "./dist/host/bun.js"
      },
      "./host/deno": {
        "types": "./dist/host/deno.d.ts",
        "import": "./dist/host/deno.js",
        "module-sync": "./dist/host/deno.js"
      },
      "./host/node": {
        "types": "./dist/host/node.d.ts",
        "import": "./dist/host/node.js",
        "module-sync": "./dist/host/node.js"
      },
      "./http": {
        "types": "./dist/http/index.d.ts",
        "import": "./dist/http/index.js",
        "module-sync": "./dist/http/index.js"
      },
      "./ws": {
        "types": "./dist/ws/index.d.ts",
        "import": "./dist/ws/index.js",
        "module-sync": "./dist/ws/index.js"
      }
    }
  },
  "dependencies": {
    "@nmtjs/common": "workspace:*",
    "@nmtjs/protocol": "workspace:*",
    "crossws": "0.4.6"
  },
  "devDependencies": {
    "@nmtjs/application": "workspace:*",
    "@nmtjs/client": "workspace:*",
    "@nmtjs/contract": "workspace:*",
    "@nmtjs/core": "workspace:*",
    "@nmtjs/gateway": "workspace:*",
    "@nmtjs/json-format": "workspace:*",
    "@nmtjs/type": "workspace:*",
    "@nmtjs/ws-client": "workspace:*",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0"
  },
  "peerDependencies": {
    "@nmtjs/application": "workspace:*",
    "@nmtjs/common": "workspace:*",
    "@nmtjs/core": "workspace:*",
    "@nmtjs/gateway": "workspace:*",
    "@nmtjs/protocol": "workspace:*",
    "@types/bun": "^1.3.0",
    "@types/deno": "^2.3.0",
    "@types/node": "^24.13.2",
    "uWebSockets.js": "^20.67.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "@types/deno": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    },
    "uWebSockets.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14",
    "deno": ">=2.9.5"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "README.md"
  ]
}
