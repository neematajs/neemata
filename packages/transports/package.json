{
  "name": "@nmtjs/transports",
  "description": "First-party transports, server hosts, and protocol handlers for Neemata.",
  "type": "module",
  "exports": {
    "./http-server": {
      "types": "./src/http-server/index.ts",
      "import": "./dist/http-server/index.js",
      "module-sync": "./dist/http-server/index.js"
    },
    "./http-server/bun": {
      "types": "./src/http-server/bun.ts",
      "import": "./dist/http-server/bun.js",
      "module-sync": "./dist/http-server/bun.js"
    },
    "./http-server/deno": {
      "types": "./src/http-server/deno.ts",
      "import": "./dist/http-server/deno.js",
      "module-sync": "./dist/http-server/deno.js"
    },
    "./http-server/node": {
      "types": "./src/http-server/node.ts",
      "import": "./dist/http-server/node.js",
      "module-sync": "./dist/http-server/node.js"
    },
    "./neemata/http": {
      "types": "./src/neemata/http/index.ts",
      "import": "./dist/neemata/http/index.js",
      "module-sync": "./dist/neemata/http/index.js"
    },
    "./json-rpc": {
      "types": "./src/json-rpc/index.ts",
      "import": "./dist/json-rpc/index.js",
      "module-sync": "./dist/json-rpc/index.js"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "import": "./dist/mcp/index.js",
      "module-sync": "./dist/mcp/index.js"
    },
    "./neemata/ws": {
      "types": "./src/neemata/ws/index.ts",
      "import": "./dist/neemata/ws/index.js",
      "module-sync": "./dist/neemata/ws/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./http-server": {
        "types": "./dist/http-server/index.d.ts",
        "import": "./dist/http-server/index.js",
        "module-sync": "./dist/http-server/index.js"
      },
      "./http-server/bun": {
        "types": "./dist/http-server/bun.d.ts",
        "import": "./dist/http-server/bun.js",
        "module-sync": "./dist/http-server/bun.js"
      },
      "./http-server/deno": {
        "types": "./dist/http-server/deno.d.ts",
        "import": "./dist/http-server/deno.js",
        "module-sync": "./dist/http-server/deno.js"
      },
      "./http-server/node": {
        "types": "./dist/http-server/node.d.ts",
        "import": "./dist/http-server/node.js",
        "module-sync": "./dist/http-server/node.js"
      },
      "./neemata/http": {
        "types": "./dist/neemata/http/index.d.ts",
        "import": "./dist/neemata/http/index.js",
        "module-sync": "./dist/neemata/http/index.js"
      },
      "./json-rpc": {
        "types": "./dist/json-rpc/index.d.ts",
        "import": "./dist/json-rpc/index.js",
        "module-sync": "./dist/json-rpc/index.js"
      },
      "./mcp": {
        "types": "./dist/mcp/index.d.ts",
        "import": "./dist/mcp/index.js",
        "module-sync": "./dist/mcp/index.js"
      },
      "./neemata/ws": {
        "types": "./dist/neemata/ws/index.d.ts",
        "import": "./dist/neemata/ws/index.js",
        "module-sync": "./dist/neemata/ws/index.js"
      }
    }
  },
  "dependencies": {
    "@nmtjs/common": "workspace:*",
    "@nmtjs/protocol": "workspace:*",
    "crossws": "0.4.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@nmtjs/application": "workspace:*",
    "@nmtjs/client": "workspace:*",
    "@nmtjs/contract": "workspace:*",
    "@nmtjs/core": "workspace:*",
    "@nmtjs/gateway": "workspace:*",
    "@nmtjs/type": "workspace:*",
    "jayson": "^4.3.0",
    "json-rpc-2.0": "^1.7.1",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0"
  },
  "peerDependencies": {
    "@nmtjs/application": "workspace:*",
    "@nmtjs/common": "workspace:*",
    "@nmtjs/core": "workspace:*",
    "@nmtjs/gateway": "workspace:*",
    "@nmtjs/protocol": "workspace:*",
    "@types/bun": "^1.3.0",
    "@types/deno": "^2.3.0",
    "@types/node": "^24.13.2",
