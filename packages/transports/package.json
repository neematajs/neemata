    "@types/deno": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    },
    "uWebSockets.js": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14",
    "deno": ">=2.9.5"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "README.md"
  ]
}
