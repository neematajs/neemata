{
  "name": "neemata",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "clean-build": "pnpm run --parallel -r clean-build",
    "build": "pnpm run build:ts",
    "dev": "pnpm run clean-build && pnpm tsc -b tsconfig.build.json --watch",
    "clean": "rm -rf dist node_modules && pnpm -r exec rm -rf dist node_modules",
    "test": "pnpm build && vitest --run",
    "test:neem": "pnpm --filter @nmtjs/neem run test",
    "test:integration:services": "pnpm --filter @nmtjs/pubsub --filter @nmtjs/workflows run test:integration",
    "test:unit": "vitest run",
    "test:dev": "vitest dev --ui --coverage",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "bench:integration": "vitest bench --run --config vitest.bench.integration.config.ts",
    "bench:paired": "node scripts/benchmarks/paired.js",
    "coverage:paired": "node scripts/coverage/paired.js",
    "check:type": "pnpm tsc -b tsconfig.json --noEmit --pretty false",
    "check:lint": "oxlint --quiet .",
    "check:fmt": "oxfmt --check .",
    "check": "pnpm run check:fmt && pnpm run check:lint && pnpm run check:type",
    "fmt": "oxfmt --write .",
    "build:ts": "pnpm tsc -b tsconfig.build.json --pretty false",
    "test:prom-client": "pnpm --filter @nmtjs/prom-client run test",
    "test:proxy": "pnpm --filter @nmtjs/proxy run test",
    "version:stack": "node scripts/release.js bump-stack"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/ui": "5.0.2",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "7.0.1-rc",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
